<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN">

    <Properties>
        <Property name="LOG_DIR">/home/xring/log/BrmCmStatBatch</Property> <!-- 로그가 저장 될 경로 -->
    </Properties>

    <Appenders>
        <Console name="Console" target="SYSTEM_OUT">
            <PatternLayout pattern="%d %p [%C{1}] - %m%n" />
        </Console>

        <RollingFile name="File" fileName="${LOG_DIR}/service.out"
                     filePattern="${LOG_DIR}/service.out.%d{yyyy-MM-dd}.log">
            <PatternLayout pattern="%d %p [%l] - %m%n" />
            <Policies>
                <TimeBasedTriggeringPolicy />
            </Policies>
        </RollingFile>
    </Appenders>

    <Loggers>
        <!-- SQL 로그 (datasource-proxy) -->
        <Logger name="jdbc.query" level="INFO" />

        <Root level="INFO">
            <AppenderRef ref="Console" />
            <AppenderRef ref="File" />
        </Root>
    </Loggers>

</Configuration>
